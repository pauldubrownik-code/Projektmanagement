[Unit]
Description=Projektmanagement Kanban + Gantt Server
After=network.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/home/hermes/Projektmanagement
ExecStart=/usr/bin/python3 /home/hermes/Projektmanagement/server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target